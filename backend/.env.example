APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- ヤマト運輸 B2クラウド（送り状 CSV）----
# 送り状種類（5:着払い, 0:発払い, A:ネコポス, 8:宅急便コンパクト）・クール区分（0:通常, 1:冷凍, 2:冷蔵）
YAMATO_B2_SLIP_TYPE=5
YAMATO_B2_COOL_TYPE=0
# ご請求先顧客コード（お客様コード）・分類コード・運賃管理番号は B2クラウドの契約情報で確認する。
# 着払い（5）では使わないので空のままでよい
YAMATO_B2_CUSTOMER_CODE=
YAMATO_B2_CUSTOMER_CLASS_CODE=
YAMATO_B2_FREIGHT_NUMBER=01
# 品名（空なら「先頭の商品名 他N点」）
YAMATO_B2_ITEM_NAME=
# ご依頼主（発送元）は管理画面「店舗・工場情報」で設定する。ここは管理画面が空の項目だけに使う
YAMATO_B2_SENDER_NAME=
YAMATO_B2_SENDER_PHONE=
YAMATO_B2_SENDER_POSTAL=
YAMATO_B2_SENDER_ADDRESS=
YAMATO_B2_SENDER_BUILDING=
# 1行目に項目名を出力するか（B2クラウドの取込設定に合わせる）
YAMATO_B2_HEADER_ROW=true
