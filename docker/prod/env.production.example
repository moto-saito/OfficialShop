# 本番（さくらのクラウド）用の環境変数テンプレート。
# コピーして値を埋め、`docker run --env-file` で渡す。実ファイルは Git に入れないこと。
# ※ --env-file は引用符をそのまま値に含めるので、値を " で囲まないこと。
#   cp docker/prod/env.production.example /opt/official-shop/.env.production

APP_NAME=公式ショップ
APP_ENV=production
APP_DEBUG=false
# echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://shop.example.jp
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# コンテナ内 Apache の待受ポート
PORT=8000

# ロードバランサ / リバースプロキシの IP・CIDR（カンマ区切り）。直接公開なら空のまま
TRUSTED_PROXIES=

# ---- DB: データベースアプライアンス（MariaDB / PostgreSQL）またはサーバー上の DB ----
# MariaDB の場合: DB_CONNECTION=mariadb, DB_PORT=3306
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=official_shop
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

# ---- 画像 ----
# サーバー1台でボリュームを永続化するなら local のままでよい。
# AppRun など永続ディスクが無い環境 / 複数台構成ならオブジェクトストレージ(s3)を使う。
MEDIA_DISK_DRIVER=local
# MEDIA_DISK_DRIVER=s3
# MEDIA_S3_ENDPOINT=https://s3.isk01.sakurastorage.jp
# MEDIA_S3_REGION=jp-north-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_KEY=
# MEDIA_S3_SECRET=
# MEDIA_S3_URL=https://s3.isk01.sakurastorage.jp/<bucket>
# MEDIA_S3_PATH_STYLE=true

# ---- 初期管理者（存在しない場合のみ作成）----
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# メール（注文通知等を送るなら SMTP を設定）
MAIL_MAILER=log
