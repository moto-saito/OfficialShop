# 本番（さくらのクラウド）用の環境変数テンプレート。
# コピーして値を埋め、`docker run --env-file` で渡す。実ファイルは Git に入れないこと。
# ※ --env-file は引用符をそのまま値に含めるので、値を " で囲まないこと。
#   cp docker/prod/env.production.example /opt/official-shop/.env.production

APP_NAME=公式ショップ
APP_ENV=production
APP_DEBUG=false
# echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=https://shop.example.jp
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# コンテナ内 Apache の待受ポート
PORT=8000

# ロードバランサ / リバースプロキシの IP・CIDR（カンマ区切り）。直接公開なら空のまま
TRUSTED_PROXIES=

# ---- DB: データベースアプライアンス（MariaDB / PostgreSQL）またはサーバー上の DB ----
# MariaDB の場合: DB_CONNECTION=mariadb, DB_PORT=3306
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=official_shop
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# PostgreSQL のスキーマ名（同一インスタンスを環境ごとにスキーマで分ける。事前に CREATE SCHEMA しておく）
DB_SCHEMA=production

# ---- 画像 ----
# サーバー1台でボリュームを永続化するなら local のままでよい。
# AppRun など永続ディスクが無い環境 / 複数台構成ならオブジェクトストレージ(s3)を使う。
MEDIA_DISK_DRIVER=local
# MEDIA_DISK_DRIVER=s3
# MEDIA_S3_ENDPOINT=https://s3.isk01.sakurastorage.jp
# MEDIA_S3_REGION=jp-north-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_KEY=
# MEDIA_S3_SECRET=
# MEDIA_S3_URL=https://s3.isk01.sakurastorage.jp/<bucket>
# MEDIA_S3_PATH_STYLE=true

# ---- 初期管理者（存在しない場合のみ作成）----
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- ヤマト運輸 B2クラウド（送り状 CSV）----
# 送り状種類（5:着払い, 0:発払い, A:ネコポス, 8:宅急便コンパクト）・クール区分（0:通常, 1:冷凍, 2:冷蔵）
YAMATO_B2_SLIP_TYPE=5
YAMATO_B2_COOL_TYPE=0
# ご請求先顧客コード（お客様コード）・分類コード・運賃管理番号は B2クラウドの契約情報で確認する。
# 着払い（5）では使わないので空のままでよい
YAMATO_B2_CUSTOMER_CODE=
YAMATO_B2_CUSTOMER_CLASS_CODE=
YAMATO_B2_FREIGHT_NUMBER=01
# 品名（空なら「先頭の商品名 他N点」）
YAMATO_B2_ITEM_NAME=
# ご依頼主（発送元）は管理画面「店舗・工場情報」で設定する。ここは管理画面が空の項目だけに使う
YAMATO_B2_SENDER_NAME=
YAMATO_B2_SENDER_PHONE=
YAMATO_B2_SENDER_POSTAL=
YAMATO_B2_SENDER_ADDRESS=
YAMATO_B2_SENDER_BUILDING=
# 1行目に項目名を出力するか（B2クラウドの取込設定に合わせる）
YAMATO_B2_HEADER_ROW=true

# メール（注文通知等を送るなら SMTP を設定）
MAIL_MAILER=log
